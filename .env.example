# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# Local-first LLM (Ollama / LM Studio / llama.cpp OpenAI-compatible server)
LOCAL_LLM_ENABLED=true
LOCAL_LLM_AUTOSTART=true
LOCAL_LLM_BASE_URL="http://127.0.0.1:11434/v1"
LOCAL_LLM_MODEL="worknote-qwen2.5-1.5b"
LOCAL_LLM_MODEL_PATH="models/qwen2.5-1.5b-instruct-q4_k_m.gguf"
LOCAL_LLM_CONTEXT_SIZE=8192
LOCAL_LLM_THREADS=8
# CPU wheel: 0. CUDA wheel: -1 để offload toàn bộ layer có thể lên GPU.
LOCAL_LLM_GPU_LAYERS=0
LOCAL_LLM_API_KEY=""
LOCAL_LLM_CONNECT_TIMEOUT_MS=1500
LOCAL_LLM_TIMEOUT_MS=45000
LOCAL_LLM_MAX_INPUT_CHARS=24000
# true: tác vụ text dùng OpenRouter/Gemini khi local lỗi; false: text chỉ chạy local
ALLOW_CLOUD_LLM_FALLBACK=true

# Multi-Provider AI (Optional - enhances STT & cost-saving fallback)
# GROQ_API_KEY: Free ultra-fast Whisper Speech-To-Text (https://console.groq.com)
GROQ_API_KEY=""

# OPENROUTER_API_KEY: Access to 100% free models (https://openrouter.ai)
OPENROUTER_API_KEY=""
OPENROUTER_MODELS="openrouter/free,qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# Optional local configuration
PORT=3000
UPLOAD_DIR=uploads
NODE_ENV=development
MAX_FILE_SIZE_MB=50

# Rate limiting overrides (optional)
# RATE_LIMIT_GENERAL_MAX=150
# RATE_LIMIT_HEAVY_AI_MAX=10

# Firebase client config for optional auth/data sync features
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-firebase-auth-domain"
VITE_FIREBASE_PROJECT_ID="your-firebase-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-firebase-storage-bucket"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-firebase-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-firebase-app-id"
