{
  "name": "worknote",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "husky install",
    "dev": "tsx watch server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "eslint .",
    "test": "corepack pnpm run typecheck && corepack pnpm run test:unit && corepack pnpm run test:frontend",
    "typecheck": "tsc --noEmit",
    "test:unit": "node scripts/run-backend-tests.mjs unit",
    "test:integration": "node scripts/run-backend-tests.mjs integration",
    "test:frontend": "vitest run",
    "test:smoke": "node scripts/smoke-production.mjs",
    "check": "corepack pnpm run lint && corepack pnpm test && corepack pnpm run build && corepack pnpm run test:smoke"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/pdf-parse": "^1.1.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "firebase": "^12.14.0",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "motion": "^12.23.24",
    "msedge-tts": "^2.0.6",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1",
    "simple-mind-map": "0.14.0-fix.3",
    "ws": "^8.21.0",
    "xlsx": "^0.18.5",
    "youtube-transcript": "^1.3.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^16.0.0",
    "husky": "^8.0.0",
    "jsdom": "^26.0.0",
    "lint-staged": "^14.0.0",
    "playwright": "^1.61.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.14.0 <23",
    "pnpm": "9.15.9"
  }
}
