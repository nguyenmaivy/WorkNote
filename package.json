{
  "name": "worknote",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "husky install",
    "dev": "tsx watch server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "eslint .",
    "test": "corepack pnpm run typecheck && corepack pnpm run test:unit && corepack pnpm run test:frontend",
    "typecheck": "tsc --noEmit",
    "test:unit": "node scripts/run-backend-tests.mjs unit",
    "test:integration": "node scripts/run-backend-tests.mjs integration",
    "test:frontend": "vitest run",
    "test:smoke": "node scripts/smoke-production.mjs",
    "audit:ci": "node scripts/audit-dependencies.mjs",
    "check": "corepack pnpm run lint && corepack pnpm test && corepack pnpm run build && corepack pnpm run test:smoke"
  },
